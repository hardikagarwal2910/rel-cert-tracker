# App
# The public URL of the deployed app (e.g. https://rel-cert-tracker.vercel.app)
NEXT_PUBLIC_APP_URL=

NODE_ENV=development

# Auth (NextAuth.js)
# The canonical URL of the app — must match NEXT_PUBLIC_APP_URL in production
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32   (must be at least 32 chars)
NEXTAUTH_SECRET=

# Supabase
# Found in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Found in: Supabase dashboard → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Found in: Supabase dashboard → Settings → API → service_role secret key
# NEVER expose this on the client — server-side only
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (service account)
# Found in: Google Cloud Console → IAM → Service Accounts → your account → email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Found in: Service account → Keys → Add Key → JSON → "private_key" field
# Replace literal \n with actual newlines when pasting into Vercel env vars
GOOGLE_PRIVATE_KEY=
# The Google Drive folder ID where PDFs will be stored
# Found in the URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Email (Resend)
# Found in: resend.com → API Keys → Create API Key
RESEND_API_KEY=
# The "from" address for all outgoing emails
EMAIL_FROM=noreply@raghuvirexim.com
# Recipient for cert-expiry notifications
NOTIFICATION_EMAIL=hardik.agarwal@raghuvirexim.com
# Recipient for PDF approval request emails
PDF_APPROVER_EMAIL=marketing@raghuvirexim.com

# OCR (Anthropic Claude)
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Encryption (AES-256)
# Generate with: openssl rand -hex 32   (must be at least 32 chars)
ENCRYPTION_KEY=

# Cron job security token
# Generate with: openssl rand -hex 32
# Set in Vercel as CRON_SECRET and in vercel.json cron Authorization header
CRON_SECRET=
